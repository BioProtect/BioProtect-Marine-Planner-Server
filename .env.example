# Copy to .env.local and fill in. Every key here is read by the server;
# BIOPROTECT_<KEY> environment variables override them (e.g. BIOPROTECT_DB_NAME).

# --- Database (required) ---
db_name=bioprotect
db_host=localhost
db_user=
db_pass=
# Postgres port
port=5432

# --- Server ---
server_port=8080
# Required: any long random string each
cookie_secret=
access_token=
refresh_token=
# Required: comma-separated origins allowed to call the API
permitted_domains=http://localhost:4500
# Required: max hexes in one planning grid
planning_grid_unit_limit=100000
disable_security=false
disable_file_logging=false
enable_reset=false
# Paths to an https certificate, or none
certfile=none
keyfile=none
wdpa_version=

# --- Sensitivity data (required at startup) ---
# Both files are in git. The server loads them on every start.
maresa=data/Marine_Pressures_Activities_Database_v1_3/MarESA-Data-Extract-20190731.xlsx
jncc=data/Marine_Pressures_Activities_Database_v1_3/JNCC_Sensitivities_Final.csv
# Only read if data/eunis_codes.json (in git) is missing
input_all_habitats=data/shapefiles/All_Habitats.shp

# --- Optional ---
# Mapbox access token (legacy)
mbat=
